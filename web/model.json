{
  "name": "RSV admission risk of advanced respiratory support",
  "name_zh": "RSV 入院高级呼吸支持风险",
  "version": "1.0.0",
  "algorithm": "L2-penalised logistic regression (C = 1.0)",
  "preprocessing": "median imputation then RobustScaler, both fitted on the development cohort",
  "prediction_landmark": "admission assessment",
  "outcome": "subsequent use of advanced respiratory support during hospitalisation (HFNC, non-invasive ventilation, invasive ventilation, or documented escalation)",
  "population": "RSV-positive children aged ≤24 months admitted with wheezing or lower-respiratory illness",
  "not_for_clinical_use": true,
  "features": [
    {
      "id": "age_months",
      "label_en": "Age",
      "label_zh": "月龄",
      "unit_en": "months",
      "unit_zh": "月",
      "type": "continuous",
      "min": 0,
      "max": 24,
      "step": 0.1,
      "default": 8,
      "impute": 8,
      "center": 8,
      "scale": 10,
      "coef": -0.6881798873611532,
      "odds_ratio": 0.5024898253261062
    },
    {
      "id": "resp_rate_admission",
      "label_en": "Admission respiratory rate",
      "label_zh": "入院呼吸频率",
      "unit_en": "breaths/min",
      "unit_zh": "次/分",
      "type": "continuous",
      "min": 16,
      "max": 90,
      "step": 1,
      "default": 34,
      "impute": 34,
      "center": 34,
      "scale": 8,
      "coef": 0.8058161775535413,
      "odds_ratio": 2.2385227854821172
    },
    {
      "id": "spo2_admission_pct",
      "label_en": "Admission SpO₂",
      "label_zh": "入院脉搏血氧饱和度",
      "unit_en": "%",
      "unit_zh": "%",
      "type": "continuous",
      "min": 70,
      "max": 100,
      "step": 1,
      "default": 96,
      "impute": 96,
      "center": 96,
      "scale": 3,
      "coef": -0.5599756259208429,
      "odds_ratio": 0.5712229867134302
    },
    {
      "id": "dyspnea_or_breathing_difficulty",
      "label_en": "Dyspnoea",
      "label_zh": "呼吸困难",
      "unit_en": "",
      "unit_zh": "",
      "type": "binary",
      "min": 0,
      "max": 1,
      "step": 1,
      "default": 0,
      "impute": 0,
      "center": 0,
      "scale": 1,
      "coef": 0.5246088417954119,
      "odds_ratio": 1.689797740838278
    },
    {
      "id": "wheezing",
      "label_en": "Wheezing",
      "label_zh": "喘息",
      "unit_en": "",
      "unit_zh": "",
      "type": "binary",
      "min": 0,
      "max": 1,
      "step": 1,
      "default": 1,
      "impute": 1,
      "center": 1,
      "scale": 1,
      "coef": -0.26324414122189255,
      "odds_ratio": 0.7685542386335723
    }
  ],
  "intercept": -3.0357358072611307,
  "examples": [
    {
      "id": "typical",
      "label_zh": "示例 1",
      "label_en": "Example 1",
      "age_months": 8,
      "resp_rate_admission": 34,
      "spo2_admission_pct": 96,
      "dyspnea_or_breathing_difficulty": 0,
      "wheezing": 1
    },
    {
      "id": "event",
      "label_zh": "示例 2",
      "label_en": "Example 2",
      "age_months": 3,
      "resp_rate_admission": 46,
      "spo2_admission_pct": 93,
      "dyspnea_or_breathing_difficulty": 0,
      "wheezing": 1
    },
    {
      "id": "high",
      "label_zh": "示例 3",
      "label_en": "Example 3",
      "age_months": 1,
      "resp_rate_admission": 55,
      "spo2_admission_pct": 89,
      "dyspnea_or_breathing_difficulty": 1,
      "wheezing": 1
    }
  ],
  "input_handling": "Missing, None, NaN and blank inputs use development medians. Non-numeric, infinite, out-of-range and non-binary values are rejected."
}
